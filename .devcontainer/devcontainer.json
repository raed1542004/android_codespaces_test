{
  "name": "Android Studio (Light & Fast)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",

  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "jdkDistro": "tem",
      "installGradle": true,
      "gradleVersion": "8.7"
    },
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "android",
      "webPort": "6080",
      "vncPort": "5901"
    }
  },

  "remoteEnv": {
    "ANDROID_HOME": "/workspaces/android-sdk",
    "ANDROID_SDK_ROOT": "/workspaces/android-sdk",
    "STUDIO_VM_OPTIONS": "-Djava.awt.headless=false -Dsun.java2d.uiScale=1.0",
    "PATH": "${containerEnv:PATH}:/workspaces/android-sdk/platform-tools:/workspaces/android-sdk/cmdline-tools/latest/bin:/opt/android-studio/bin"
  },

  "postCreateCommand": "bash .devcontainer/install.sh",

  "postStartCommand": "echo '✅ Codespace ready! Access Android Studio via port 6080 (noVNC). Password: android'",

  "forwardPorts": [6080, 5901],

  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.java",
        "vscjava.vscode-java-pack",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "java.configuration.runtimes": [
          {
            "name": "JavaSE-17",
            "path": "/usr/local/sdkman/candidates/java/current",
            "default": true
          }
        ]
      }
    },
    "codespaces": {
      "openFiles": [
        "testproject/app/src/main/java/com/example/helloandroid/MainActivity.java"
      ]
    }
  }
}
